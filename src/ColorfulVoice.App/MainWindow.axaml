<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ColorfulVoice.Controls"
        x:Class="ColorfulVoice.MainWindow"
        Title="ColorfulVoice — Phase 0 握手"
        Width="960" Height="420"
        MinWidth="640" MinHeight="280"
        Background="#0E0E14">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="ColorfulVoice" FontSize="22" FontWeight="SemiBold" Foreground="#F2F2F7" />
      <TextBlock x:Name="SubtitleText"
                 Text="NanoFish 引擎握手验证"
                 FontSize="12" Foreground="#8E8E9A" />
    </StackPanel>

    <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" BorderBrush="#22222E" BorderThickness="1">
      <controls:WaveformView x:Name="Waveform" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText"
                 VerticalAlignment="Center"
                 FontSize="12" Foreground="#8E8E9A"
                 Text="正在调用 NanoFish…" />
      <TextBlock Grid.Column="1"
                 FontSize="12" Foreground="#4FD1C5"
                 Text="零拷贝 · Span&lt;float&gt; → 原生内存" />
    </Grid>
  </Grid>
</Window>