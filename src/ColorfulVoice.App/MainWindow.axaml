<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ColorfulVoice.Controls"
        xmlns:views="using:ColorfulVoice.Views"
        x:Class="ColorfulVoice.MainWindow"
        Title="ColorfulVoice — 钢琴卷帘"
        Width="1080" Height="640"
        MinWidth="360" MinHeight="480"
        Background="#FFFFFF">

  <Grid>
    <views:HomeView x:Name="Home" />

    <Grid x:Name="Editor" RowDefinitions="Auto,*,Auto" Margin="16" IsVisible="False">
    <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto" Margin="0,0,0,10">
      <StackPanel x:Name="TitleBlock" Spacing="2">
        <TextBlock Text="ColorfulVoice" FontSize="22" FontWeight="SemiBold" Foreground="#15151C" />
        <TextBlock x:Name="SubtitleText"
                   Text="NanoFish 引擎握手验证"
                   FontSize="12" Foreground="#6E6E7A" />
      </StackPanel>
      <WrapPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="‹ 主页" Click="OnBackClick" Padding="12,6" />
        <Button x:Name="PlayButton" Content="▶ 预览" Click="OnPlayClick" Padding="12,6" />
        <Button x:Name="ExportButton" Content="导出 WAV" Click="OnExportClick" Padding="12,6" />
        <Button x:Name="OpenUstButton" Content="打开 UST…" Click="OnOpenUstClick" Padding="12,6" />
        <TextBlock x:Name="BadgeText" VerticalAlignment="Center"
                   FontSize="12" Foreground="#5B6FC4"
                   Text="Skia 自绘 · 零拷贝 PCM" />
      </WrapPanel>
    </Grid>

    <TabControl Grid.Row="1" Padding="0">
      <TabItem Header="钢琴卷帘">
        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#E4E6EF" BorderThickness="1">
          <controls:PianoRoll x:Name="Roll" />
        </Border>
      </TabItem>
      <TabItem Header="波形">
        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#E4E6EF" BorderThickness="1">
          <controls:WaveformView x:Name="Waveform" />
        </Border>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusText" Grid.Row="2"
               Margin="0,10,0,0"
               FontSize="12" Foreground="#6E6E7A"
               Text="正在调用 NanoFish…" />
    </Grid>
  </Grid>
</Window>