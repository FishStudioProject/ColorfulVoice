<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ColorfulVoice.Controls"
             xmlns:views="using:ColorfulVoice.Views"
             x:Class="ColorfulVoice.Views.MainView"
             Background="#FFFFFF"
             FontFamily="{StaticResource DefaultFontFamily}">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EEF0F8" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="WrapPanel.compact Button">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <views:HomeView x:Name="Home" />

    <Grid x:Name="Editor" RowDefinitions="Auto,*,Auto" Margin="16" IsVisible="False">
    <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel x:Name="TitleBlock" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="ColorfulVoice" FontSize="20" FontWeight="SemiBold" Foreground="#15151C" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#EEF0F8" CornerRadius="10" Padding="8,3">
            <TextBlock x:Name="BankChipText" Text="未选择音源" FontSize="11" Foreground="#4A5578" />
          </Border>
          <TextBlock x:Name="InfoText" Text="0 个音符 · Tempo 120"
                     FontSize="11" Foreground="#8A8F9E" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="2"
                  VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Classes="tool" ToolTip.Tip="返回首页" Click="OnBackClick">
          <PathIcon Width="18" Height="18" Data="{DynamicResource PhHouse}" />
        </Button>
        <Button x:Name="PlayButton" Classes="tool" ToolTip.Tip="预览播放" Click="OnPlayClick">
          <PathIcon Width="18" Height="18" Data="{DynamicResource PhPlay}" />
        </Button>
        <Button x:Name="SaveButton" Classes="tool" ToolTip.Tip="保存 UST" Click="OnSaveClick">
          <PathIcon Width="18" Height="18" Data="{DynamicResource PhFloppydisk}" />
        </Button>
        <Button x:Name="MoreButton" Classes="tool" ToolTip.Tip="更多">
          <PathIcon Width="18" Height="18" Data="{DynamicResource PhDotsthree}" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="音源管理器…" Click="OnBankClick" />
              <MenuItem Header="批量歌词…" Click="OnLyricsClick" />
              <MenuItem Header="呼吸音（br）" ToggleType="CheckBox" Click="OnBreathToggle" />
              <MenuItem Header="保存 UST" Click="OnSaveClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Padding="0">
      <TabItem Header="钢琴卷帘">
        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#E4E6EF" BorderThickness="1">
          <controls:PianoRoll x:Name="Roll" />
        </Border>
      </TabItem>
      <TabItem Header="波形">
        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#E4E6EF" BorderThickness="1">
          <controls:WaveformView x:Name="Waveform" />
        </Border>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusText" Grid.Row="2"
               Margin="2,10,0,0"
               FontSize="12" Foreground="#8A8F9E"
               TextTrimming="CharacterEllipsis"
               Text="正在调用 NanoFish…" />
    </Grid>

    <!-- 页面内浮层：Android 单视图不能创建 Window，所有二级界面都挂在这里 -->
    <Border x:Name="Overlay" IsVisible="False" Background="#FFFFFF">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Margin="16,12,16,8">
          <Button Classes="tool" ToolTip.Tip="返回" Click="OnOverlayClose">
            <PathIcon Width="18" Height="18" Data="{DynamicResource PhHouse}" />
          </Button>
          <TextBlock x:Name="OverlayTitle" Grid.Column="1" Margin="10,0,0,0"
                     VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#15151C" />
        </Grid>
        <ContentControl x:Name="OverlayContent" Grid.Row="1" Margin="16,0,16,16" />
      </Grid>
    </Border>
  </Grid>

</UserControl>
