<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ColorfulVoice.Controls"
             x:Class="ColorfulVoice.Views.HomeView"
             Background="#FFFFFF"
             FontFamily="{StaticResource DefaultFontFamily}">

  <UserControl.Styles>
    <Style Selector="Button.home">
      <Setter Property="Height" Value="76" />
      <Setter Property="Background" Value="#7C8FD8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#101018" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="26,0" />
    </Style>
    <Style Selector="Button.home:pointerover">
      <Setter Property="Background" Value="#93A5E8" />
    </Style>
    <Style Selector="Button.home:pressed">
      <Setter Property="Background" Value="#6A7DC6" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="#15151C" />
      <Setter Property="FontWeight" Value="Light" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- 宽屏：左标题、右按钮 -->
    <Grid x:Name="WideRoot" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" Margin="56,44,56,28">
      <StackPanel VerticalAlignment="Center" Spacing="6">
        <TextBlock x:Name="WideTitle" Classes="title" Text="ColorfulVoice" FontSize="62" FontFamily="{StaticResource DefaultFontFamily}" />
        <TextBlock Text="0.1.0 Preview" FontSize="20" Foreground="#6E6E7A" Margin="6,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Width="380" Spacing="16" VerticalAlignment="Center">
        <Button Classes="home Rounded" Click="OnNewClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhPlus}" />
            <TextBlock Text="创建新作品" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="home Rounded" Click="OnContinueClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhPlay}" />
            <TextBlock Text="继续项目" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="home Rounded" Click="OnImportClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhDownloadsimple}" />
            <TextBlock Text="导入项目" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Border Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"
              Background="#F2F3F7" BorderBrush="#E3E5EE" BorderThickness="1"
              CornerRadius="28" Padding="26,12" Margin="0,24,0,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button ToolTip.Tip="首页" Width="44" Height="44" CornerRadius="22" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="Transparent">
            <PathIcon Width="20" Height="20" Data="{DynamicResource PhHouse}" />
          </Button>
          <Button ToolTip.Tip="更多" Width="44" Height="44" CornerRadius="22" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="Transparent">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="音源管理…" Click="OnVoicebankClick" />
              </MenuFlyout>
            </Button.Flyout>
            <PathIcon Width="20" Height="20" Data="{DynamicResource PhDotsthree}" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 窄屏 / 移动端：标题在上，按钮竖排铺满 -->
    <Grid x:Name="CompactRoot" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" Margin="28,44,28,20">
      <StackPanel Spacing="4">
        <TextBlock x:Name="CompactTitle" Classes="title" Text="ColorfulVoice" FontSize="48" />
        <TextBlock Text="0.1.0 Preview" FontSize="18" Foreground="#6E6E7A" Margin="4,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="16" Margin="0,40,0,0">
        <Button Classes="home Rounded" Click="OnNewClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhPlus}" />
            <TextBlock Text="创建新作品" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="home Rounded" Click="OnContinueClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhPlay}" />
            <TextBlock Text="继续项目" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="home Rounded" Click="OnImportClick">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <PathIcon Width="24" Height="24" Data="{DynamicResource PhDownloadsimple}" />
            <TextBlock Text="导入项目" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Border Grid.Row="3" HorizontalAlignment="Center"
              Background="#F2F3F7" BorderBrush="#E3E5EE" BorderThickness="1"
              CornerRadius="28" Padding="26,12" Margin="0,24,0,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button ToolTip.Tip="首页" Width="44" Height="44" CornerRadius="22" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="Transparent">
            <PathIcon Width="20" Height="20" Data="{DynamicResource PhHouse}" />
          </Button>
          <Button ToolTip.Tip="更多" Width="44" Height="44" CornerRadius="22" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="Transparent">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="音源管理…" Click="OnVoicebankClick" />
              </MenuFlyout>
            </Button.Flyout>
            <PathIcon Width="20" Height="20" Data="{DynamicResource PhDotsthree}" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
