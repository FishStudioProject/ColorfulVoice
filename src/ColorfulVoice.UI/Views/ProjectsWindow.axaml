<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ColorfulVoice.Views.ProjectsWindow"
        x:CompileBindings="False"
        Title="继续项目"
        Width="760" Height="520"
        Background="#FFFFFF">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Spacing="4">
      <TextBlock Text="继续项目" FontSize="20" FontWeight="SemiBold" Foreground="#15151C" />
      <TextBlock Text="最近打开过的 UST 工程" FontSize="12" Foreground="#6E6E7A" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,14,0,0" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="10">
      <ListBox x:Name="ProjectList" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#15151C" />
                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#8A8A96" />
              </StackPanel>
              <Button Grid.Column="1" Content="⋯" Padding="10,4" VerticalAlignment="Center">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="打开" Click="OnOpenItemClick" />
                    <MenuItem Header="导出 WAV…" Click="OnExportItemClick" />
                    <MenuItem Header="从列表移除" Click="OnRemoveItemClick" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,10,0,0" FontSize="12" Foreground="#6E6E7A"
               Text="双击工程直接打开；⋯ 里有导出 WAV。" />
  </Grid>
</Window>
