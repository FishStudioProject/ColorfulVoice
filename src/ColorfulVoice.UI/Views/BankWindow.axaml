<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ColorfulVoice.Views.BankWindow"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        x:CompileBindings="False"
        Title="音源管理器"
        Width="860" Height="580"
        Background="#FFFFFF"
        FontFamily="{StaticResource DefaultFontFamily}">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PathText" Text="未选择音源" FontSize="16" FontWeight="SemiBold" Foreground="#15151C" />
        <TextBlock x:Name="SummaryText" Text="选择 oto.ini 后可查看条目与缺失别名" FontSize="12" Foreground="#6E6E7A" />
        <TextBlock x:Name="PhonemeText" Text="" FontSize="12" Foreground="#1F9E8F" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="音源库…" Click="OnScanLibraryClick" Padding="12,6" />
        <Button Content="导入音源文件夹…" Click="OnImportFolderClick" Padding="12,6" />
        <Button Content="选择 oto.ini…" Click="OnPickClick" Padding="12,6" />
      </StackPanel>
    </Grid>

    <ListBox x:Name="LibraryList" Grid.Row="1" IsVisible="False" MaxHeight="160"
             SelectionChanged="OnLibrarySelectionChanged" Background="Transparent" />

    <Grid Grid.Row="2" ColumnDefinitions="*,16,*" Margin="0,14,0,0">
      <Border BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="条目" FontSize="12" Foreground="#6E6E7A" Margin="2,0,0,6" />
          <ListBox x:Name="EntriesList" Grid.Row="1" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,2">
                  <TextBlock Text="{Binding Alias}" FontSize="13" FontWeight="SemiBold" Foreground="#15151C" />
                  <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#8A8A96" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock x:Name="MissingTitle" Text="当前工程缺失别名" FontSize="12" Foreground="#B4553C" Margin="2,0,0,6" />
          <ListBox x:Name="MissingList" Grid.Row="1" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="13" Foreground="#B4553C" Margin="0,2" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="完成" Click="OnCloseClick" Padding="16,6" />
    </StackPanel>
  </Grid>
</suki:SukiWindow>
